{
  "name": "archiver",
  "private": true,
  "version": "0.1.0",
  "description": "Private self-hosted archival system for Git repositories",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fastify": "5.12.6"
    }
  },
  "scripts": {
    "build:packages": "pnpm --filter @repo-archive/shared --filter @repo-archive/archive-format --filter @repo-archive/git-exec --filter @repo-archive/cli --filter @repo-archive/api-client build",
    "build": "pnpm build:packages && pnpm --filter @repo-archive/api build && pnpm --filter @repo-archive/web build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @repo-archive/e2e exec playwright install chromium && pnpm --filter @repo-archive/e2e test",
    "test:manifest": "node scripts/check-test-manifest.mjs",
    "test:coverage": "vitest run --coverage",
    "coverage:audit": "node scripts/coverage-audit.mjs",
    "lint": "eslint .",
    "dev:api": "pnpm --filter @repo-archive/api dev",
    "dev:web": "pnpm --filter @repo-archive/web dev",
    "start": "node apps/api/dist/main.js",
    "inventory": "node scripts/write-inventory.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  }
}
