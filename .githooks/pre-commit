#!/usr/bin/env bash
# Reject commits that would attribute work to github.com/felix (wrong noreply).
set -euo pipefail

author_email="${GIT_AUTHOR_EMAIL:-$(git config --get user.email || true)}"
committer_email="${GIT_COMMITTER_EMAIL:-$(git config --get user.email || true)}"

forbidden='felix@users.noreply.github.com'

check_email() {
  local label="$1"
  local email="$2"
  if [ -z "$email" ]; then
    echo "pre-commit: no $label email (set git user.email or fix GIT_*_EMAIL)" >&2
    exit 1
  fi
  if [ "$email" = "$forbidden" ]; then
    echo "pre-commit: blocked $label email $email (maps to wrong GitHub user github.com/felix)." >&2
    echo "Use 25182703+filoucool@users.noreply.github.com or felix@nexumnet.com." >&2
    exit 1
  fi
  if [[ "$email" == *@users.noreply.github.com ]] && [[ "$email" != *"+filoucool@"* ]] && [[ "$email" != *"dependabot"* ]]; then
    echo "pre-commit: blocked $label email $email (unscoped GitHub noreply — use 25182703+filoucool@...)." >&2
    exit 1
  fi
}

check_email author "$author_email"
check_email committer "$committer_email"
